# ─────────────────────────────────────────────────────────────────────────
# Database — Neon Postgres (Vercel marketplace integration sets this for you)
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────
# MCP connector
# ─────────────────────────────────────────────────────────────────────────
# The public origin advertised in OAuth metadata. Set this in production.
# Without it the app falls back to the request's x-forwarded-host, which is
# correct on a custom domain but wrong on a deployment-hash URL (those are
# gated by Vercel SSO and claude.ai gets a 403 following them).
MCP_PUBLIC_URL=https://noble-notations.ryanjnoble.dev

# ─────────────────────────────────────────────────────────────────────────
# Administrator identity — Neon Auth
# ─────────────────────────────────────────────────────────────────────────
# Who is allowed to approve an MCP connector on the OAuth consent screen.
# Nothing else on the site is behind a login.
#
# Vercel's Neon Auth integration injects the endpoint for you. Older
# provisionings named it NEON_AUTH_URL; either variable is accepted.
NEON_AUTH_BASE_URL=

# Signing key for the session cookie. NOT injected by Vercel — set it
# yourself, in every environment. Rotating it signs everyone out.
# Generate with:  openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=

# Comma-separated allow-list of addresses that may approve connectors.
# Neon Auth will happily create an account for anyone who reaches its hosted
# sign-in page, so this is the control that matters. An empty list means
# nobody can approve anything — the gate fails closed.
ALLOWED_EMAILS=you@example.com

# ─────────────────────────────────────────────────────────────────────────
# Deploy-time archive load — optional, off by default
# ─────────────────────────────────────────────────────────────────────────
# `pnpm build` migrates on every build but only loads the archive when a
# deployment asks. Set this to 1 for a one-off production run, then unset
# it. The route that suits a pull request is a committed `.ingest-request`
# file instead — it needs no project setting at all. See AGENTS.md.
# INGEST_ON_DEPLOY=1
