                                          "content": "4",
                                          "fill": "$fd-ink"
                                        },
                                        "hCfUs": {
                                          "content": "NOTE · OBSERVATION",
                                          "fill": "$fd-ink-3"
                                        },
                                        "yzCTh": {
                                          "content": "Equipment and expected yield",
                                          "fill": "$fd-ink"
                                        },
                                        "x6hpfW": {
                                          "content": "Thirty steel hooks, 7 cm, 13 g each — €29.97 the set. The 13 g is subtracted from every gross weight. Expect about forty-five per cent of net, so roughly 4.5 kg finished from 10 kg raw across 25–30 pieces.",
