                                },
                                "CgRk7": {
                                  "content": "Ratios good, coverage short"
                                },
                                "OXL7B": {
                                  "content": "Salt at 13.85 g/kg tasted right and became the reference figure for every later batch. The dredge was mixed by ratio rather than by coverage, so the final 1.6 kg went on bare — the pieces are edible but visibly paler and taste under-seasoned. Batch 5 raised seasoning volume by 40% because of this."
                                }
                              }
