                              "children": [
                                {
                                  "type": "text",
                                  "id": "KlGsL",
                                  "name": "p",
                                  "fill": "$e-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Wash the jalapeños and slice into rings about 1/4 inch thick, discarding the stems. Combine the vinegar, water, sugar, salt, peppercorns and bay leaf in a saucepan and bring to a boil, stirring until the sugar and salt dissolve. Reduce the heat and simmer for 5 minutes.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "$e-body",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "R15FIK",
                                  "name": "p",
                                  "fill": "$e-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Pack the sliced jalapeños and garlic into clean glass jars, pour the hot brine over so they are completely covered, and let the jars cool to room temperature. Seal and refrigerate at least 24 hours before eating.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "$e-body",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "C3aswS",
                                  "name": "V",
                                  "fill": "$e-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Variations worth trying: 2½ tsp sesame oil in the brine · cauliflower florets and green beans for colour · jicama sticks for crunch · white wine in place of the water · cumin and chilli powder in the brine.",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$e-head",
                                  "fontSize": 16,
                                  "fontWeight": "normal",
                                  "fontStyle": "italic"
                                }
