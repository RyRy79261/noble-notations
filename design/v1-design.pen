                                          "content": "M3",
                                          "width": 26,
                                          "lineHeight": 1.7
                                        },
                                        "XZ7H8": {
                                          "content": "Collagen converts to gelatin",
                                          "fontSize": 17,
                                          "lineHeight": 1.3
                                        },
                                        "vtUZm": {
                                          "content": "Cartilage-rich veal knuckle needs hours below the boil for its collagen to hydrolyse. This is what makes a finished sauce coat the back of a spoon, and it is why a hard boil ruins the texture instead of hurrying it.",
                                          "fontSize": 14,
                                          "lineHeight": 1.7
                                        },
                                        "Og1rD": {
                                          "content": "8+ HOURS · HELD UNDER 100 °C",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "lineHeight": 1.7
                                        }
                                      }
                                    },
