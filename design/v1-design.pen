                                  "name": "Lede",
                                  "fill": "$e-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": 640,
                                  "content": "A state is never edited and never removed. Beside each one is a sentence describing what the dish became, which is the only part of a version history a cook can act on.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "$e-body",
                                  "fontSize": 15,
                                  "fontWeight": "normal"
                                },
                                {
                                  "id": "Eghuq",
                                  "type": "ref",
                                  "ref": "ClyMW",
                                  "name": "Sixth state",
                                  "width": "fill_container",
                                  "descendants": {
                                    "WpLtr": {
                                      "content": "Sixth state"
                                    },
                                    "mTJw5": {
                                      "content": "08 SEPTEMBER 2026"
                                    },
                                    "S2U17": {
                                      "enabled": true
                                    },
                                    "bGDtk": {
                                      "content": "The wash increased by thirty per cent and the seasoning by forty, both taken from what batch five ran short of. Salt was deliberately held flat at 13.85 g/kg against that reading: salt dissolves, so it does not need a volume bump for coverage, and over-salting is the one error here that cannot be corrected."
                                    },
                                    "RfBa0": {
                                      "enabled": false
                                    }
                                  }
                                },
                                {
                                  "id": "Z0KSi",
                                  "type": "ref",
                                  "ref": "ClyMW",
                                  "name": "Fifth state",
                                  "width": "fill_container",
