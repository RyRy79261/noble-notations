                        },
                        {
                          "type": "text",
                          "id": "toxni",
                          "name": "Lede",
                          "fill": "$d-ink-2",
                          "textGrowth": "fixed-width",
                          "width": 940,
                          "content": "NN-FS-001 declares its language as ASD-STE100 Simplified Technical English. That standard was written by the AECMA in 1986 for one purpose: aircraft maintenance manuals. A cooking repository built on immutable revisions, numbered procedures, consumable-material lists and recorded batch measurements is not merely like a maintenance manual — it is structurally the same document. So this direction borrows the apparatus, and every borrowed device does a job the specification already asked for.",
                          "lineHeight": 1.7,
                          "fontFamily": "$d-body",
                          "fontSize": 16.5,
                          "fontWeight": "normal"
                        },
