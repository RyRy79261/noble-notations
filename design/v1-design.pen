                                                  "fill": "$fd-ink",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Planned at ten kilograms, not yet cooked. Built from batch four’s per-kilogram ratios — the most complete batch without substitution problems — then batch five’s learnings applied: thirty per cent more wash and forty per cent more seasoning. Salt deliberately held flat at 13.85 g/kg rather than raised: salt dissolves, so it does not need a volume bump for coverage, and over-salting is the one error here that cannot be corrected.",
                                                  "lineHeight": 1.8,
                                                  "fontFamily": "$f-sans",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
