                                      "id": "vnGwM",
                                      "type": "ref",
                                      "ref": "g5Ck40",
                                      "name": "M2 Pyrolization of tomato sugars",
                                      "width": "fill_container",
                                      "gap": 12,
                                      "descendants": {
