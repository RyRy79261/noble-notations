                              "descendants": {
                                "RJ0oo": {
                                  "content": "1"
                                },
                                "hCfUs": {
                                  "content": "NOTE · PREPARATION"
                                },
                                "yzCTh": {
                                  "content": "Grind it apart from everything else"
                                },
                                "x6hpfW": {
                                  "content": "Crack the coriander on its own, coarse, and add it to the dredge last. Ground with the salt and the pepper it turns to dust and vanishes into the wash — the piece comes out the right flavour but the wrong colour. Kept separate and kept coarse, it stays on the surface where you can see it, which is the whole reason it is in the dredge and not the wash."
                                }
