                                    {
                                      "id": "RAj1d",
                                      "type": "ref",
                                      "ref": "iqGkO",
                                      "name": "Coriander is the one that matters",
                                      "width": "fill_container",
                                      "descendants": {
                                        "RJ0oo": {
                                          "content": "1",
                                          "fill": "$f-ink"
                                        },
                                        "hCfUs": {
                                          "content": "NOTE · OBSERVATION",
                                          "fill": "$f-ink-3"
                                        },
                                        "yzCTh": {
                                          "content": "Coriander is the one that matters"
                                        },
                                        "x6hpfW": {
                                          "content": "Ground with everything else it goes to powder; ground alone and coarsely it stays as visible pieces in the finished cure. That visibility is the point of the whole grind."
                                        }
                                      }
                                    },
                                    {
                                      "id": "BJ4sk",
                                      "type": "ref",
                                      "ref": "iqGkO",
                                      "name": "Salt: conservative or full +40%",
                                      "width": "fill_container",
                                      "descendants": {
                                        "RJ0oo": {
                                          "content": "2",
                                          "fill": "$f-caution"
                                        },
                                        "hCfUs": {
                                          "content": "CAUTION · SUBSTITUTION",
                                          "fill": "$f-caution"
                                        },
                                        "yzCTh": {
                                          "content": "Salt: conservative or full +40%"
                                        },
                                        "x6hpfW": {
                                          "content": "The alternative reading of the batch five note gives 193.9 g. Batches four and five both tasted right at 13.5–13.85 g/kg, so this revision takes the conservative figure. If the finished batch reads under-seasoned rather than under-covered, that is the number to revisit."
                                        }
                                      }
                                    },
                                    {
                                      "id": "l8gcm",
                                      "type": "ref",
                                      "ref": "f26BEU",
                                      "name": "A broken wash cannot be reused",
                                      "width": "fill_container",
                                      "descendants": {
                                        "ajHNN": {
                                          "content": "3"
                                        },
                                        "Jd80f": {
                                          "content": "WARNING"
                                        },
                                        "Y8aHsJ": {
                                          "content": "A broken wash cannot be reused"
                                        },
                                        "N9fiB": {
                                          "content": "If the meat warms while you work, fat and myoglobin bleed out and the wash separates. It will not re-emulsify. Discard it and mix again rather than carrying it through to the dredge."
                                        }
                                      }
                                    },
                                    {
                                      "id": "sfNde",
                                      "type": "ref",
                                      "ref": "iqGkO",
                                      "name": "Equipment and expected yield",
                                      "width": "fill_container",
                                      "descendants": {
                                        "RJ0oo": {
                                          "content": "4",
                                          "fill": "$f-ink"
                                        },
                                        "hCfUs": {
                                          "content": "NOTE · OBSERVATION",
                                          "fill": "$f-ink-3"
                                        },
                                        "yzCTh": {
                                          "content": "Equipment and expected yield"
                                        },
                                        "x6hpfW": {
                                          "content": "Thirty steel hooks, 7 cm, 13 g each — €29.97 the set. The 13 g is subtracted from every gross weight. Expect about forty-five per cent of net, so roughly 4.5 kg finished from 10 kg raw across 25–30 pieces."
                                        }
                                      }
                                    }
