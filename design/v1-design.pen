                        {
                          "type": "text",
                          "id": "szNCV",
                          "name": "Lede",
                          "fill": "#5A4A46",
                          "textGrowth": "fixed-width",
                          "width": 940,
                          "content": "Issue 1 was drawn from the Blueprint Technical archetype: pure black on pure white with a cold technical blue. It was legible and it was correct, and it was also colder than a cooking repository has any reason to be. Finn & Tonry solves the same problem with one warm hue family — deep oxblood ink on warm cream, with a blush tint for the step chips — and nothing else. Issue 2 takes that reading. The structure is untouched: the change bars, the WARNING / CAUTION / NOTE ranking, the page furniture and the mass-flow schematic all stand. Only the ink changed.",
                          "lineHeight": 1.7,
                          "fontFamily": "$d-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
