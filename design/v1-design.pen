                                          "content": "M2",
                                          "width": 26,
                                          "lineHeight": 1.7
                                        },
                                        "XZ7H8": {
                                          "content": "Pyrolization of tomato sugars",
                                          "fontSize": 17,
                                          "lineHeight": 1.3
                                        },
                                        "vtUZm": {
                                          "content": "Tomato paste cut with vinegar and brushed over the roasted bones, then returned to a cooler oven. The paste's sugars break down rather than burn, leaving a savoury crust that dissolves into the stock.",
                                          "fontSize": 14,
                                          "lineHeight": 1.7
                                        },
                                        "Og1rD": {
                                          "content": "204 °C · 20 MIN · AFTER THE FIRST ROAST",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "lineHeight": 1.7
                                        }
                                      }
                                    },
                                    {
                                      "id": "A9eLSW",
                                      "type": "ref",
                                      "ref": "g5Ck40",
                                      "name": "M3 Collagen converts to gelatin",
