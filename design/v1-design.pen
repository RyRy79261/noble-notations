                        {
                          "type": "text",
                          "id": "D29M9",
                          "name": "T",
                          "fill": "$f-ink",
                          "content": "Apparatus from D, manners from E",
                          "lineHeight": 1.05,
                          "fontFamily": "$f-serif",
                          "fontSize": 72,
                          "fontWeight": "500",
                          "letterSpacing": -1
                        },
                        {
                          "type": "text",
                          "id": "Z6tWRu",
                          "name": "L",
                          "fill": "$f-ink-2",
                          "textGrowth": "fixed-width",
                          "width": 940,
                          "content": "The two directions were never really in conflict. D’s value was its machinery — devices that make a versioned repository legible while you read it. E’s value was its manners — knowing when a rule is doing work and when it is only noise. D wrapped everything in boxes; E left everything bare. F keeps D’s machinery and gives it E’s discipline: a rule appears only where data genuinely needs one, and everything else is separated by air and a change of type.",
                          "lineHeight": 1.7,
                          "fontFamily": "$f-sans",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
