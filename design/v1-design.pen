                          "fill": "$d-ink-3",
                          "textGrowth": "fixed-width",
                          "width": 940,
                          "content": "Secondary references: Massimo Vignelli’s New York City Transit Authority Graphics Standards Manual (1970) for the plate-numbered spread and the single-accent rule system; Otto Neurath’s Isotype for showing quantity as repeated units; Dieter Rams’ Braun documentation for restraint. None of these are quoted decoratively — each supplies one working device.",
                          "lineHeight": 1.7,
                          "fontFamily": "$d-body",
                          "fontSize": 14.5,
                          "fontWeight": "normal"
                        }
