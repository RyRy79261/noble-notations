                                  "ref": "DpqHf",
                                  "name": "You add, you never edit",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rFDti": {
                                      "content": "02"
                                    },
                                    "Z3LuwM": {
                                      "content": "You add, you never edit"
                                    },
                                    "m9pTk": {
                                      "content": "A revision cannot be changed once it is made. To improve a dish you add a revision on top."
                                    },
                                    "FzR9O": {
                                      "enabled": false
                                    }
                                  }
                                },
