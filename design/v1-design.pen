                          "gap": 52,
                          "children": [
                            {
                              "type": "frame",
                              "id": "VYNzK",
                              "name": "Left",
                              "width": 300,
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "prK8g",
                                  "name": "L",
                                  "fill": "$e-ink",
                                  "content": "THE DEVICE",
                                  "fontFamily": "$e-mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": 1.4
                                },
                                {
                                  "type": "text",
                                  "id": "J31ceR",
                                  "name": "T",
                                  "fill": "$e-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Rembrandt’s Three Crosses exists in five states. The fourth is not a correction of the third — it is a different picture, cut from the same copper. A catalogue raisonné records all five, and beside each one it prints a sentence describing what the artist did.",
                                  "lineHeight": 1.65,
                                  "fontFamily": "$e-body",
                                  "fontSize": 15,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "gi7IS",
                              "name": "Right",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 22,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "vgzcF",
                                  "name": "Lede",
                                  "fill": "$e-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "NN-FS-001 §5.1 states the product in one line: “To make a dish better, you add a revision. You do not edit the old one.” That is the printmaker’s plate. Direction D read this as a maintenance manual and drew change bars — a mechanical record of which lines moved. A catalogue reads it differently, and better: it asks a scholar to say, in a sentence, what the sixth state became.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "$e-body",
                                  "fontSize": 18,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "Qu8sN",
                                  "name": "Isomorphism",
                                  "width": "fill_container",
                                  "layout": "vertical",
                                  "children": [
