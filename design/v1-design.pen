                                    "S2U17": {
                                      "enabled": false
                                    },
                                    "bGDtk": {
                                      "content": "Substitutions throughout, forced by what was in the shop. The wash ran short and the dredge did not cover the last pieces — the two shortfalls that the sixth state exists to correct."
                                    },
                                    "RfBa0": {
                                      "enabled": false
                                    }
                                  }
                                },
