                            },
                            {
                              "type": "frame",
                              "id": "CiPpf",
                              "name": "Centre",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 32,
                              "children": [
                                {
                                  "id": "WW8A9",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M1 Maillard browning of the bone surface",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M1"
                                    },
                                    "XZ7H8": {
                                      "content": "Maillard browning of the bone surface"
                                    },
                                    "vtUZm": {
                                      "content": "Amino acids and reducing sugars recombine above roughly 140 °C into hundreds of new aromatic compounds. This is where the colour and most of the roasted flavour of a brown stock is made — not in the long simmer that follows it."
                                    },
                                    "Og1rD": {
                                      "content": "232 °C · 45 MIN · SINGLE LAYER ON A RACK"
                                    }
                                  }
                                },
                                {
                                  "id": "Xmk8D",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M2 Pyrolization of tomato sugars",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M2"
                                    },
                                    "XZ7H8": {
                                      "content": "Pyrolization of tomato sugars"
                                    },
                                    "vtUZm": {
                                      "content": "Tomato paste cut with vinegar and brushed over the roasted bones, then returned to a cooler oven. The paste's sugars break down rather than burn, leaving a savoury crust that dissolves into the stock."
                                    },
                                    "Og1rD": {
                                      "content": "204 °C · 20 MIN · AFTER THE FIRST ROAST"
                                    }
                                  }
                                },
                                {
                                  "id": "t4sK6",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M3 Collagen converts to gelatin",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M3"
                                    },
                                    "XZ7H8": {
                                      "content": "Collagen converts to gelatin"
                                    },
                                    "vtUZm": {
                                      "content": "Cartilage-rich veal knuckle needs hours below the boil for its collagen to hydrolyse. This is what makes a finished sauce coat the back of a spoon, and it is why a hard boil ruins the texture instead of hurrying it."
                                    },
                                    "Og1rD": {
                                      "content": "8+ HOURS · HELD UNDER 100 °C"
                                    }
                                  }
                                },
                                {
                                  "id": "Sigi9",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M4 The protein raft",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M4"
                                    },
                                    "XZ7H8": {
                                      "content": "The protein raft"
                                    },
                                    "vtUZm": {
                                      "content": "Egg white and ice are stirred into cold stock and the pot is reheated slowly. Coagulating albumen forms a raft that traps fine particulate and carries it to the surface, taking the cloudiness with it."
                                    },
                                    "Og1rD": {
                                      "content": "4 °C → 71 °C · 4 WHITES · NO STIRRING"
                                    }
                                  }
                                },
                                {
                                  "id": "oLqjb",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M5 Adsorption filtration",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M5"
                                    },
                                    "XZ7H8": {
                                      "content": "Adsorption filtration"
                                    },
                                    "vtUZm": {
                                      "content": "Diatomaceous earth over damp filter paper. Particles far smaller than the pore size are held by surface attraction rather than sieved, which is what takes a clear stock to an optically clear one."
                                    },
                                    "Og1rD": {
                                      "content": "GRAVITY · FINAL PASS"
                                    }
                                  }
                                },
                                {
                                  "id": "HQhER",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M6 Two barriers, two mechanisms",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M6"
                                    },
                                    "XZ7H8": {
                                      "content": "Two barriers, two mechanisms"
                                    },
                                    "vtUZm": {
                                      "content": "Duxelles is cooked dry so it absorbs moisture; the crêpe or prosciutto layer blocks it. They are not interchangeable, and treating the duxelles as a flavour layer rather than a sponge is the usual reason pastry goes soggy."
                                    },
                                    "Og1rD": {
                                      "content": "DRY DUXELLES + SEALED WRAP"
                                    }
                                  }
                                },
                                {
                                  "id": "I7WJT",
                                  "type": "ref",
                                  "ref": "g5Ck40",
                                  "name": "M7 Carryover",
                                  "width": "fill_container",
                                  "descendants": {
                                    "rtlE1": {
                                      "content": "M7"
                                    },
                                    "XZ7H8": {
                                      "content": "Carryover"
                                    },
                                    "vtUZm": {
                                      "content": "The centre keeps climbing after the dish leaves the oven. Pulling early is not undercooking — it is accounting for a gradient that has not finished moving."
                                    },
                                    "Og1rD": {
                                      "content": "PULL 48 °C → RESTS TO 54 °C"
                                    }
                                  }
                                }
                              ]
