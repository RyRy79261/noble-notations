                                        "hCfUs": {
                                          "content": "CAUTION · IDEA",
                                          "fill": "$f-caution"
                                        },
                                        "yzCTh": {
                                          "content": "Salt: conservative or full +40%"
                                        },
                                        "x6hpfW": {
                                          "content": "The alternative reading of the batch five note gives 193.9 g. Batches four and five both tasted right at 13.5–13.85 g/kg, so this revision takes the conservative figure. If the finished batch reads under-seasoned rather than under-covered, that is the number to revisit."
                                        }
                                      }
                                    },
                                    {
                                      "id": "Ptvix",
                                      "type": "ref",
                                      "ref": "f26BEU",
                                      "name": "A broken wash cannot be reused",
                                      "width": "fill_container",
                                      "descendants": {
                                        "ajHNN": {
                                          "content": "3"
                                        },
                                        "Jd80f": {
                                          "content": "WARNING"
                                        },
                                        "Y8aHsJ": {
                                          "content": "A broken wash cannot be reused"
                                        },
                                        "N9fiB": {
                                          "content": "If the meat warms while you work, fat and myoglobin bleed out and the wash separates. It will not re-emulsify. Discard it and mix again rather than carrying it through to the dredge."
                                        }
                                      }
                                    },
