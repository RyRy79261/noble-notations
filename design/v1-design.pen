                              "id": "o8YEK3",
                              "name": "Placement",
                              "fill": "$text-muted",
                              "textGrowth": "fixed-width",
                              "width": 1120,
                              "content": "Placement decision — the batch control sits in a bar above the tab strip, beside Add to shopping list, and never inside a panel. Step chips in the Method panel scale from it, so if it lived in the Ingredients panel it would measure 0 × 0 the moment a reader opened Method. That is the same fault R-SCR-03 fixed for the basket control, and it is the only placement that lets one scale provider feed every quantity on the page (R-CMP-11).",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-sans",
                              "fontSize": 13.5,
                              "fontWeight": "normal"
                            }
