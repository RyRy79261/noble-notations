                                {
                                  "id": "o28FW",
                                  "type": "ref",
                                  "ref": "RoMGO",
                                  "name": "Coriander is the one that matters",
                                  "width": "fill_container",
                                  "descendants": {
                                    "zEHQF": {
                                      "content": "1",
                                      "fill": "$e-ink"
                                    },
                                    "SlV3a": {
                                      "content": "OBSERVATION",
                                      "fill": "$e-ink-3"
                                    },
                                    "a3oCJ": {
                                      "content": "Coriander is the one that matters",
                                      "fill": "$e-ink"
                                    },
                                    "XOStC": {
                                      "content": "Ground with everything else it goes to powder; ground alone and coarsely it stays as visible pieces in the finished cure. That visibility is the point of the whole grind."
                                    }
                                  }
                                },
                                {
                                  "id": "bvbY0",
                                  "type": "ref",
                                  "ref": "RoMGO",
                                  "name": "A broken wash cannot be reused",
                                  "width": "fill_container",
                                  "descendants": {
                                    "zEHQF": {
                                      "content": "2",
                                      "fill": "$e-red"
                                    },
                                    "SlV3a": {
                                      "content": "WARNING",
                                      "fill": "$e-red"
                                    },
                                    "a3oCJ": {
                                      "content": "A broken wash cannot be reused",
                                      "fill": "$e-red"
                                    },
                                    "XOStC": {
                                      "content": "If the meat warms while you work, fat and myoglobin bleed out and the wash separates. It will not re-emulsify. Discard it and mix again rather than carrying it through to the dredge."
                                    }
                                  }
                                },
                                {
                                  "id": "RQjkQ",
                                  "type": "ref",
                                  "ref": "RoMGO",
                                  "name": "Salt: conservative or full +40%",
                                  "width": "fill_container",
                                  "descendants": {
                                    "zEHQF": {
                                      "content": "3",
                                      "fill": "$e-ink"
                                    },
                                    "SlV3a": {
                                      "content": "SUBSTITUTION",
                                      "fill": "$e-ink-3"
                                    },
                                    "a3oCJ": {
                                      "content": "Salt: conservative or full +40%",
                                      "fill": "$e-ink"
                                    },
                                    "XOStC": {
                                      "content": "The alternative reading of the batch five note gives 193.9 g. Batches four and five both tasted right at 13.5–13.85 g/kg, so this state takes the conservative figure. If the finished batch reads under-seasoned rather than under-covered, that is the number to revisit."
                                    }
                                  }
                                },
                                {
                                  "id": "eU3rF",
                                  "type": "ref",
                                  "ref": "RoMGO",
                                  "name": "Equipment and expected yield",
                                  "width": "fill_container",
                                  "descendants": {
                                    "zEHQF": {
                                      "content": "4",
                                      "fill": "$e-ink"
                                    },
                                    "SlV3a": {
                                      "content": "OBSERVATION",
                                      "fill": "$e-ink-3"
                                    },
                                    "a3oCJ": {
                                      "content": "Equipment and expected yield",
                                      "fill": "$e-ink"
                                    },
                                    "XOStC": {
                                      "content": "Thirty steel hooks, 7 cm, 13 g each — €29.97 the set. The 13 g is subtracted from every gross weight. Expect about 45% of net, so roughly 4.5 kg finished from 10 kg raw across 25–30 pieces."
                                    }
                                  }
                                }
