                                  "descendants": {
                                    "rFDti": {
                                      "content": "01"
                                    },
                                    "Z3LuwM": {
                                      "content": "A recipe has a name"
                                    },
                                    "m9pTk": {
                                      "content": "The name never changes. The ingredients and the steps belong to a revision, not to the recipe."
                                    },
                                    "FzR9O": {
                                      "enabled": false
                                    }
                                  }
                                },
                                {
                                  "id": "Ppov4",
