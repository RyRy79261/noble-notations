                                      "content": "Irish silverside, 7.98 kg, from Gourmet Experts in Berlin. €209.26 the lot, or €26.22 per kilogram raw — the same supplier used for every run since."
                                    }
                                  }
                                },
                                {
                                  "id": "fiKXj",
                                  "type": "ref",
                                  "ref": "uSZ2n",
                                  "name": "29 NOV 2024",
                                  "width": "fill_container",
                                  "stroke": "$f-hair",
                                  "strokeWidth": {
                                    "top": 1
                                  },
                                  "strokeAlignment": "inner",
                                  "padding": [
                                    14,
                                    0,
                                    15,
                                    0
                                  ],
                                  "descendants": {
                                    "DHQ2p": {
                                      "content": "29 NOV 2024"
                                    },
                                    "US5zk": {
                                      "content": "Cut across the grain into twenty-four pieces between 248 g and 412 g, trimmed of hard fat but not of the seam fat inside the eye."
                                    }
                                  }
                                },
                                {
                                  "id": "hG9NW",
                                  "type": "ref",
                                  "ref": "uSZ2n",
                                  "name": "30 NOV 2024",
                                  "width": "fill_container",
                                  "stroke": "$f-hair",
                                  "strokeWidth": {
                                    "top": 1
                                  },
                                  "strokeAlignment": "inner",
                                  "padding": [
