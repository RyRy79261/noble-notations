      "name": "DIRECTION E — CATALOGUE",
      "fill": "#E8E2D8",
      "layout": "vertical",
      "gap": 160,
      "padding": 150,
      "children": [
        {
          "type": "frame",
          "id": "zKGbk",
          "name": "Direction head",
          "width": 1500,
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "text",
              "id": "UP23I",
              "name": "Kicker",
              "fill": "$e-ink-2",
              "content": "D I R E C T I O N   E",
              "fontFamily": "$e-mono",
              "fontSize": 14,
              "fontWeight": "normal",
              "letterSpacing": 3
            },
            {
              "type": "text",
              "id": "HZ724",
              "name": "Name",
              "fill": "$e-ink",
              "content": "CATALOGUE",
              "lineHeight": 0.95,
              "fontFamily": "$e-head",
              "fontSize": 110,
              "fontWeight": "500",
              "letterSpacing": -2
            },
            {
              "type": "text",
              "id": "f7GWri",
              "name": "Desc",
              "fill": "$e-ink-2",
              "textGrowth": "fixed-width",
              "width": 1120,
              "content": "A catalogue raisonné for a dish. In printmaking a plate is worked, printed, reworked and printed again; each version is a state, and scholars record every one with a written description of what changed. That is this product’s data model, arriving from art history rather than from engineering.",
              "lineHeight": 1.55,
              "fontFamily": "$e-body",
              "fontSize": 22,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
