                        {
                          "type": "frame",
                          "id": "PWzI1",
                          "name": "Borrowed",
                          "width": "fill_container",
                          "gap": 44,
                          "children": [
                            {
                              "type": "frame",
                              "id": "tEZE9",
                              "name": "WHAT WAS TAKEN FROM THE REFERENCE",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 11,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "qtLOa",
                                  "name": "H",
                                  "fill": "#8E2A1E",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "WHAT WAS TAKEN FROM THE REFERENCE",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$d-mono",
                                  "fontSize": 10,
                                  "fontWeight": "normal",
                                  "letterSpacing": 1.1
                                },
                                {
                                  "type": "text",
                                  "id": "XzYcj",
                                  "name": "T",
                                  "fill": "#5A4A46",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "One hue family instead of four. Oxblood carries the brand, the labels, the fills and the change bars; blush carries the tints. The cold blue is gone entirely, and with it the sense that this was a datasheet rather than something you cook from.",
                                  "lineHeight": 1.65,
                                  "fontFamily": "$d-body",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "FkS2Y",
                              "name": "WHAT WAS NOT",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 11,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "o9HaE",
                                  "name": "H",
                                  "fill": "#8E2A1E",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "WHAT WAS NOT",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$d-mono",
                                  "fontSize": 10,
                                  "fontWeight": "normal",
                                  "letterSpacing": 1.1
                                },
                                {
                                  "type": "text",
                                  "id": "I0yck",
                                  "name": "T",
                                  "fill": "#5A4A46",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Finn & Tonry has no revision history to show, so it needs no change bars and no severity ranking. Those stay, because they are what this product is. The reference supplied a palette and a temperature, not a structure.",
                                  "lineHeight": 1.65,
                                  "fontFamily": "$d-body",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "ccFLa",
                              "name": "WHERE THE COLOUR NOW LANDS",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 11,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "P9YYn",
                                  "name": "H",
                                  "fill": "#8E2A1E",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "WHERE THE COLOUR NOW LANDS",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$d-mono",
                                  "fontSize": 10,
                                  "fontWeight": "normal",
                                  "letterSpacing": 1.1
                                },
                                {
                                  "type": "text",
                                  "id": "jSOvi",
                                  "name": "T",
                                  "fill": "#5A4A46",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Step-chip quantity cells, section-head ordinals, the two aside header bars, the measurement table head, every statistic label, and the reason-for-change block. All of them were solid black in issue 1.",
                                  "lineHeight": 1.65,
                                  "fontFamily": "$d-body",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
