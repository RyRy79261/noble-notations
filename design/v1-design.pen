                                  "name": "Summary",
                                  "fill": "$f-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Bone selection, triple clarification, staged reduction and a storage protocol. Five mechanisms are pulled out of this study and referenced by the demi-glace method rather than restated in it.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "$f-sans",
                                  "fontSize": 15,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "id": "oWKjq",
                              "type": "ref",
