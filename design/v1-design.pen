                                    0,
                                    15,
                                    0
                                  ],
                                  "descendants": {
                                    "DHQ2p": {
                                      "content": "30 NOV 2024"
                                    },
                                    "US5zk": {
                                      "content": "Hung on thirty steel hooks, 13 g each, in the drying box at 24 °C. Five days, weighed every morning at the same hour."
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "id": "CJ4zu",
                              "type": "ref",
                              "ref": "AsnQn",
                              "name": "Section — How it went",
                              "width": "fill_container",
                              "descendants": {
                                "HxVXm": {
                                  "content": "II"
                                },
                                "Phvbr": {
                                  "content": "How it went"
                                },
                                "brO1x": {
                                  "content": "ONE FIX · ONE FAILURE"
                                }
                              }
                            },
                            {
                              "id": "lSGUv",
                              "type": "ref",
                              "ref": "iqGkO",
                              "name": "Note — wash",
                              "width": "fill_container",
                              "descendants": {
                                "RJ0oo": {
                                  "content": "1"
                                },
                                "hCfUs": {
                                  "content": "NOTE · RESULT"
                                },
                                "yzCTh": {
                                  "content": "The wash was scaled properly for the first time"
                                },
                                "x6hpfW": {
                                  "content": "Batches one to three mixed a wash for “a batch” and left it at that, so nothing they taught could be carried to a different weight of meat. Here it was worked out per kilogram first and multiplied up: 7.98 kg took 256.7 g, salt held at 13.85 g/kg. Every piece came out of the wash evenly wet, and the salt reading on the finished meat matched the calculation for the first time."
                                }
                              }
                            },
                            {
                              "id": "BxUT0",
                              "type": "ref",
                              "ref": "f26BEU",
                              "name": "Warning — dredge",
                              "width": "fill_container",
                              "descendants": {
                                "ajHNN": {
                                  "content": "2"
                                },
                                "Jd80f": {
                                  "content": "WHAT WENT WRONG"
                                },
                                "Y8aHsJ": {
                                  "content": "The dredge ran short on the last 1.6 kg"
                                },
                                "N9fiB": {
                                  "content": "The dredge was mixed to the same ratio as the wash, and a ratio does not cover a surface — a small piece has more surface per gram than a large one. The last five pieces off the board, 1.63 kg between them, went into the box with roughly half the coriander on them that the first nineteen carried. They dried the same and read pale, and they are the reason the fifth revision sizes the dredge for coverage rather than by ratio alone."
                                }
                              }
                            },
