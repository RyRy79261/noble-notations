{
  "name": "noble-notations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:migrate:deploy && pnpm ingest:deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts",
    "db:migrate:deploy": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts --if-configured",
    "db:studio": "drizzle-kit studio",
    "ingest": "NODE_OPTIONS=--conditions=react-server tsx scripts/ingest-archive.ts",
    "ingest:deploy": "NODE_OPTIONS=--conditions=react-server tsx scripts/ingest-archive.ts --if-requested",
    "mcp:token": "NODE_OPTIONS=--conditions=react-server tsx scripts/mint-mcp-token.ts",
    "audit:ui": "tsx scripts/audit-ui.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "export": "NODE_OPTIONS=--conditions=react-server tsx scripts/export-markdown.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "mcp-handler": "^1.1.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "fast-uri": ">=3.1.7",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "proxy-addr": ">=2.0.8",
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
